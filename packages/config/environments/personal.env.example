# ============================================================
# MY STUDIO — Personal Environment Variables
# ============================================================
# Copy this file to .env.local in the project root and fill in
# your own values. Never commit .env.local to version control.
# ============================================================

# --------------------------------------------------
# Supabase
# --------------------------------------------------
# Project URL from the Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (server-side only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------
# Modal (GPU pipeline hosting)
# --------------------------------------------------
# Base URL of your Modal deployment (e.g. https://your-org--my-studio.modal.run)
MODAL_BASE_URL=
# Shared secret token for authenticating requests to Modal
MODAL_API_SECRET_TOKEN=

# --------------------------------------------------
# Cloudinary (media storage & transformation)
# --------------------------------------------------
# Cloud name from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
# API key
CLOUDINARY_API_KEY=
# API secret (server-side only)
CLOUDINARY_API_SECRET=

# --------------------------------------------------
# Upstash Redis (rate limiting)
# --------------------------------------------------
# REST URL from the Upstash console
UPSTASH_REDIS_REST_URL=
# REST token
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------
# Deployment
# --------------------------------------------------
# Mode: development | personal | selfhost | production
DEPLOYMENT_MODE=development

# --------------------------------------------------
# Feature Flags
# --------------------------------------------------
# AVATAR is enabled by default; set to 'false' to disable.
# All other modules are disabled by default; set to 'true' to enable.
FEATURE_AVATAR=
FEATURE_MOVIE=
FEATURE_DOCUMENTARY=
FEATURE_EDITOR=
FEATURE_REMIX=
FEATURE_RIVALS=
FEATURE_NEWS=
FEATURE_WORKFLOW=
FEATURE_AUDIO=
FEATURE_THUMBNAILS=
FEATURE_CLIPPER=
FEATURE_REMIXER=
FEATURE_VIRAL_DB=
FEATURE_SPY=
FEATURE_DUBBING=
FEATURE_HUMAN_FEEL=
