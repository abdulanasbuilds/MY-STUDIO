# ============================================================
# MY STUDIO — Self-Hosting Environment Variables
# ============================================================
# Use this template when deploying MY STUDIO on your own
# infrastructure (VPS, Docker, Coolify, etc.).
#
# 1. Copy this file to .env.local (or the env source your
#    hosting platform expects).
# 2. Fill in every value — the app will refuse to start if
#    required variables are missing.
# 3. Keep this file OUT of version control.
# ============================================================

# --------------------------------------------------
# Supabase
# --------------------------------------------------
# You can use Supabase Cloud (https://supabase.com) or a
# self-hosted Supabase instance.
# Project URL from Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (server-side only — keep secret)
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------
# Modal (GPU pipeline hosting)
# --------------------------------------------------
# Deploy the MY STUDIO Modal app to your own Modal account.
# See docs/self-hosting.md for setup instructions.
# Base URL of your Modal deployment
MODAL_BASE_URL=
# Shared secret used to authenticate API → Modal requests
MODAL_API_SECRET_TOKEN=

# --------------------------------------------------
# Cloudinary (media storage & transformation)
# --------------------------------------------------
# Free tier is sufficient for personal use.
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --------------------------------------------------
# Upstash Redis (rate limiting)
# --------------------------------------------------
# Free tier available at https://upstash.com
# Alternatively, you can point to any Redis-compatible
# REST endpoint.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------
# Deployment
# --------------------------------------------------
# Set to 'selfhost' so the app applies self-hosting defaults
# (e.g. relaxed rate limits, local branding).
DEPLOYMENT_MODE=selfhost

# --------------------------------------------------
# Feature Flags
# --------------------------------------------------
# AVATAR is enabled by default; set to 'false' to disable.
# Enable only the modules you need — each enabled module
# requires its corresponding Modal GPU endpoint to be deployed.
FEATURE_AVATAR=
FEATURE_MOVIE=
FEATURE_DOCUMENTARY=
FEATURE_EDITOR=
FEATURE_REMIX=
FEATURE_RIVALS=
FEATURE_NEWS=
FEATURE_WORKFLOW=
FEATURE_AUDIO=
FEATURE_THUMBNAILS=
FEATURE_CLIPPER=
FEATURE_REMIXER=
FEATURE_VIRAL_DB=
FEATURE_SPY=
FEATURE_DUBBING=
FEATURE_HUMAN_FEEL=
